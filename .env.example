# Watsy-Chatbot Environment Variables Template
# Copy this file to .env.local and fill in the actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Connection
DATABASE_URL="postgresql://ahmed:ahmed@localhost:5432/watsy_chatbot"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=watsy_chatbot
POSTGRES_USER=ahmed
POSTGRES_PASSWORD=ahmed

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection for Caching and Rate Limiting
REDIS_URL="redis://:ahmed@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ahmed

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# NextAuth.js Configuration (if using NextAuth)
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SendGrid Configuration for Email Services
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@watsy-chatbot.com"
SENDGRID_FROM_NAME="Watsy-Chatbot Platform"

# SMTP Configuration (Alternative to SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
# Stripe Payment Processing
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# =============================================================================
# CLOUD STORAGE CONFIGURATION
# =============================================================================
# AWS S3 Configuration for Media Storage
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="watsy-chatbot-media"

# =============================================================================
# WHATSAPP INTEGRATION
# =============================================================================
# WhatsApp Business API Configuration (if using official API)
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry Configuration for Error Tracking
SENTRY_DSN="your-sentry-dsn"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="watsy-chatbot"

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Debug Settings
DEBUG="false"
LOG_LEVEL="info"

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
