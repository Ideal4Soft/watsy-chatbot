{
  "name": "watsy-chatbot",
  "version": "0.1.0",
  "description": "A comprehensive WhatsApp chatbot SaaS platform built with Next.js 14+, featuring multi-tenant architecture, real-time messaging, and visual flow builder",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:connections": "node scripts/test-connections.js",
    "test:database": "node scripts/test-database-schema.js",
    "test:auth": "node scripts/test-auth.js",
    "test:frontend-auth": "node scripts/test-frontend-auth.js",
    "test:whatsapp-devices": "node scripts/test-whatsapp-devices.js",
    "test:whatsapp-database": "node scripts/test-whatsapp-database.js",
    "test:integration": "node scripts/test-integration.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset && npm run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
