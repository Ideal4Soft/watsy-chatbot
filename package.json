    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jimp": "^0.16.13",
    "jsonwebtoken": "^9.0.2",
    "link-preview-js": "^3.1.0",
